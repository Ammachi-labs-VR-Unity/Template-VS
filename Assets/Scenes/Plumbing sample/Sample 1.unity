      String Key":{"$content":"The water is coming out too slowly, forming a weak
      stream. What will you do?","$type":"System.String"},"Question Audio":null,"A
      Answer Key":{"$content":"a) Remove and clean the filter, then reinstall it.","$type":"System.String"},"A
      Image":null,"B Answer Key":{"$content":"b) Reinstall the whole faucet.","$type":"System.String"},"B
      Image":null,"C Answer Key":{"$content":"c) Turn the water on and off quickly
      to flush it.","$type":"System.String"},"C Image":null,"D Answer Key":{"$content":"d)
      Shake the faucet to dislodge any blockages.","$type":"System.String"},"D Image":null,"E
      Answer Key (Multichoice only)":{"$content":"","$type":"System.String"},"Correct
      Answer Feedback":{"$content":"Correct! A weak stream is often caused by a clogged
      filter. Removing, cleaning, and reinstalling it can help restore proper water
      flow.","$type":"System.String"},"Incorrect Answer Feedback":{"$content":"That
      is not the best approach. Consider what might be restricting the water flow.
      Try focusing on a component that can get clogged over time.","$type":"System.String"},"Correct
      Answer Audio":null,"Correct Answer Option":{"$content":"A","$type":"Amrita.AmmachiLabs.Game_Managers.Quiz.CorrectAnswerOption"},"Single
