      String Key":{"$content":"Why do sensor faucets have both an AC power connection
      and a battery backup?","$type":"System.String"},"Question Audio":null,"A Answer
      Key":{"$content":"a) To provide extra power for stronger water pressure","$type":"System.String"},"A
      Image":null,"B Answer Key":{"$content":"b) To ensure the faucet works during
      power outages","$type":"System.String"},"B Image":null,"C Answer Key":{"$content":"c)
      To reduce electricity consumption","$type":"System.String"},"C Image":null,"D
      Answer Key":{"$content":"d) To allow users to choose between power sources","$type":"System.String"},"D
      Image":null,"E Answer Key (Multichoice only)":{"$content":"","$type":"System.String"},"Correct
      Answer Feedback":{"$content":"Correct! The battery backup ensures the faucets
      works even during power outages.","$type":"System.String"},"Incorrect Answer
